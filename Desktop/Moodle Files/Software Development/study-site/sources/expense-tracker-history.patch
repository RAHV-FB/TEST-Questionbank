
########## COMMIT 3e0834f  2026-02-09
Add a script that totals expenses by category


---
 tracker.py | 49 +++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 49 insertions(+)

diff --git a/tracker.py b/tracker.py
new file mode 100644
index 0000000..9c0e9dc
--- /dev/null
+++ b/tracker.py
@@ -0,0 +1,49 @@
+import sys
+import csv
+
+
+def calculate_totals(x):
+    d = {}
+    for e in x:
+        if e[2] not in d:
+            d[e[2]] = 0
+        d[e[2]] = d[e[2]] + e[3]
+    r = []
+    for k in d:
+        r.append((k, d[k]))
+    r.sort(key=lambda t: -t[1])
+    return r
+
+
+def run(path):
+    rows = []
+    try:
+        f = open(path)
+        reader = csv.reader(f)
+        next(reader)
+        for row in reader:
+            # skip rows that do not have all four fields
+            if len(row) == 4:
+                rows.append((row[0], row[1], row[2], float(row[3])))
+        f.close()
+    except:
+        print("could not read " + path)
+        sys.exit(1)
+
+    print("Expense report for " + path)
+    print("-" * 40)
+
+    totals = calculate_totals(rows)
+    grand = 0
+    for t in totals:
+        print(t[0].ljust(20) + ("%.2f" % t[1]).rjust(10))
+        grand = grand + t[1]
+    print("-" * 40)
+    print("TOTAL".ljust(20) + ("%.2f" % grand).rjust(10))
+
+
+if __name__ == "__main__":
+    path = "expenses.csv"
+    if len(sys.argv) > 1:
+        path = sys.argv[1]
+    run(path)

